# ---------------------------------------------------------------------------
# Line endings
#
# Without this the repository reports several hundred files as modified on a
# Windows checkout, because the index holds LF and the working tree holds CRLF.
# Normalise on commit, check out LF everywhere, and let the few files that must
# keep CRLF say so below.
# ---------------------------------------------------------------------------
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# ---------------------------------------------------------------------------
# Binary: never diffed, never line-ending-converted
# ---------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.svg   -text
*.7z    binary
*.zip   binary
*.gz    binary
*.xz    binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.pt    binary
*.pth   binary
*.ckpt  binary
*.bin   binary
*.npy   binary
*.npz   binary
*.parquet binary
*.feather binary

# ---------------------------------------------------------------------------
# Git LFS
#
# Only the packed archives under artifacts/. Unpacked trees are gitignored and
# are restored with scripts/unpack_artifacts.ps1; see artifacts/README.md.
# External-validation member checkpoints are below GitHub's per-file limit and
# are tracked directly so each fold/member can be loaded without an archive.
# ---------------------------------------------------------------------------
artifacts/*.7z filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Generated content
#
# Emitted by the training/evaluation scripts and committed so the results can be
# read without running anything. Marking them generated collapses them in GitHub
# diffs and keeps them out of the language statistics; they are still ordinary
# tracked files.
# ---------------------------------------------------------------------------
results/**                       linguist-generated=true

# Large derived JSONs: keep them in git, but do not try to diff them line by line.
data/splits/*.json               -diff
